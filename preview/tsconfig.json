{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "customConditions": []
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.mts",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ],
  "exclude": ["../node_modules"]
}
